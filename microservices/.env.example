# Copy to .env and replace placeholders. Spring Boot does not load dotenv files automatically.
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-postgres-password
# Base64 text decoding to at least 32 bytes; same value in all five services.
JWT_SECRET=replace-with-base64-secret-decoding-to-at-least-32-bytes
# Shared by Auth, Member, and Membership services only.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-service-key
AUTH_DB_URL=jdbc:postgresql://localhost:5432/gym_auth_db
MEMBER_DB_URL=jdbc:postgresql://localhost:5432/gym_member_db
MEMBERSHIP_DB_URL=jdbc:postgresql://localhost:5432/gym_membership_db
TRAINER_DB_URL=jdbc:postgresql://localhost:5432/gym_trainer_db
MEMBER_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8085
MEMBERSHIP_SERVICE_URL=http://localhost:8082
TRAINER_SERVICE_URL=http://localhost:8084
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_SECRET=replace-with-a-private-one-time-setup-secret
