# Copy to .env and replace placeholders. Spring Boot does not load dotenv files automatically.
# DB_USERNAME=postgres
# DB_PASSWORD=replace-with-local-postgres-password
# Base64 text decoding to at least 32 bytes; same value in all microservices.
JWT_SECRET=replace-with-base64-secret-decoding-to-at-least-32-bytes
# Shared by Auth, Member, and Membership services only.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-service-key

# SMTP settings used to email member account verification codes
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true


# AUTH_DB_URL=jdbc:postgresql://localhost:5432/gym_auth_db
# MEMBER_DB_URL=jdbc:postgresql://localhost:5432/gym_member_db
# MEMBERSHIP_DB_URL=jdbc:postgresql://localhost:5432/gym_membership_db
# TRAINER_DB_URL=jdbc:postgresql://localhost:5432/gym_trainer_db
MEMBER_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8085
MEMBERSHIP_SERVICE_URL=http://localhost:8082
TRAINER_SERVICE_URL=http://localhost:8084
# PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/gym_payment_db


DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

AUTH_DB_URL=jdbc:postgresql://your_neon_host/gym_auth_db?sslmode=require
MEMBER_DB_URL=jdbc:postgresql://your_neon_host/gym_member_db?sslmode=require
MEMBERSHIP_DB_URL=jdbc:postgresql://your_neon_host/gym_membership_db?sslmode=require
TRAINER_DB_URL=jdbc:postgresql://your_neon_host/gym_trainer_db?sslmode=require
PAYMENT_DB_URL=jdbc:postgresql://your_neon_host/gym_payment_db?sslmode=require

RAZORPAY_KEY_ID=rzp_test_replace-with-test-key-id
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-test-webhook-secret
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_SECRET=replace-with-a-private-one-time-setup-secret
